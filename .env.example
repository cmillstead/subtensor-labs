# Database
ENGINE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/subtensor_labs

# Redis
ENGINE_REDIS_URL=redis://localhost:6379/0

# Application
ENGINE_DEBUG=true
ENGINE_HOST=0.0.0.0
ENGINE_PORT=8000

# Bittensor
ENGINE_SUBTENSOR_NETWORK=finney
ENGINE_SUBTENSOR_ENDPOINT=

# Taostats
ENGINE_TAOSTATS_API_URL=https://api.taostats.io

# Security (generate with: python -c "import secrets; print(secrets.token_hex(32))")
ENGINE_ADDRESS_ENCRYPTION_KEY=

# Next.js
ENGINE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
